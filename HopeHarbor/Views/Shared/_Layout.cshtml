<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HopeHarbor</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HopeHarbor.styles.css" asp-append-version="true" />
    <style>
        .header {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px 100px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            z-index: 99;
            height: auto;
        }

            .header .nav a {
                position: relative;
                font-size: 1.2em;
                text-decoration: none;
                color: #fff;
                margin-left: 40px;
                font-weight: 600;
            }

                .header .nav a::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    width: 100%;
                    height: 3px;
                    background-color: #FF6633;
                    border-radius: 5px;
                    bottom: -6px;
                    transform: scaleX(0);
                    transition: .5s;
                    padding: 0 5px;
                }

                .header .nav a:hover::after {
                    transform: scaleX(1);
                }

            .header .nav .right-section {
                margin-left: auto; /* This pushes the content to the right */
            }

        main {
            padding-top: 70px; /* Adjust as needed */
        }

    </style>
</head>
<body>
     @if (User.Identity.IsAuthenticated)
    {
        <header class="header">
            <nav class="nav navbar-expand-sm container-fluid navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <div class="container-fluid">
                    <a class="navbar-brand" asp-area="" asp-controller="Disasters" asp-action="Index">HOPEHABOR</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <a  asp-area="" asp-controller="Disasters" asp-action="Index">Disaster</a>
                        <a asp-area="" asp-controller="Good_Allocation" asp-action="Index">Good_Allocation</a>
                        <a asp-area="" asp-controller="MonetaryDonations" asp-action="Index">Monetary Donation</a>

                        <a asp-area="" asp-controller="GoodsDonations" asp-action="Index">Monetary Donation</a>
                <a  asp-area="" asp-controller="GoddsCategories" asp-action="Index">Godds Categories</a>
                <a  asp-area="" asp-controller="Money_Allocation" asp-action="Index">Money_Allocatition</a>
               <div class="right-section"> <!-- Add a wrapper div for right-hand side content -->
            <partial name="_LoginPartial" />
        </div>
        </div>
        </div>
        </nav>
    </header>
    }
    @if (User.Identity is null)
    {
        <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
    }
    <hr />
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (User.Identity.IsAuthenticated)
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2023 - HopeHarbor - <a asp-area="" asp-controller="Di" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
